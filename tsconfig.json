{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@rafaelaugusto/jolt": ["./src/index.ts"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": [
      "@nativescript/types-ios",
      "@nativescript/types-ios/lib/ios/objc-x86_64/objc!Symbols",
      "@nativescript/types-android"
    ]
  },
  "include": ["src", "test"]
}
