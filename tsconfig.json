{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@rafaelaugusto/jolt": ["./src/index.ts"],
      "@rafaelaugusto/jolt/vue": ["./src/vue/index.ts"],
      "@rafaelaugusto/jolt/gestures": ["./src/gestures/index.ts"],
      "@rafaelaugusto/jolt/native": ["./src/native/index.ts"],
      "@rafaelaugusto/jolt/bottom-sheet": ["./src/bottom-sheet/index.ts"],
      "@rafaelaugusto/jolt/reorder": ["./src/reorder/index.ts"],
      "@rafaelaugusto/jolt/shared-layout": ["./src/shared-layout/index.ts"],
      "@rafaelaugusto/jolt/testing": ["./src/testing/index.ts"],
      "@rafaelaugusto/jolt/testing/native": ["./src/testing/native.ts"],
      "@rafaelaugusto/jolt/inspector": ["./src/inspector/index.ts"],
      "@rafaelaugusto/jolt/shared-navigation": ["./src/shared-navigation/index.ts"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": [
      "@nativescript/types-ios",
      "@nativescript/types-ios/lib/ios/objc-x86_64/objc!Symbols",
      "@nativescript/types-ios/lib/ios/objc-x86_64/objc!SpriteKit",
      "@nativescript/types-android"
    ],
    "resolveJsonModule": true
  },
  "include": ["src", "test"]
}
