{
  "name": "@rafaelaugusto/jolt",
  "version": "0.1.0-rc.7",
  "description": "Motion for NativeScript and the Web: presets, springs, keyframes and stagger.",
  "keywords": [
    "nativescript",
    "animation",
    "animations",
    "motion",
    "spring",
    "keyframes",
    "ios",
    "android",
    "vue",
    "web",
    "waapi"
  ],
  "author": "Rafael Augusto",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafaelaugustos/jolt.git"
  },
  "homepage": "https://github.com/rafaelaugustos/jolt#readme",
  "bugs": "https://github.com/rafaelaugustos/jolt/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "default": "./dist/vue/index.js"
    },
    "./package.json": "./package.json",
    "./gestures": {
      "types": "./dist/gestures/index.d.ts",
      "default": "./dist/gestures/index.js"
    },
    "./native": {
      "types": "./dist/native/index.d.ts",
      "default": "./dist/native/index.js"
    },
    "./bottom-sheet": {
      "types": "./dist/bottom-sheet/index.d.ts",
      "default": "./dist/bottom-sheet/index.js"
    },
    "./reorder": {
      "types": "./dist/reorder/index.d.ts",
      "default": "./dist/reorder/index.js"
    },
    "./shared-layout": {
      "types": "./dist/shared-layout/index.d.ts",
      "default": "./dist/shared-layout/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./testing/native": {
      "types": "./dist/testing/native.d.ts",
      "default": "./dist/testing/native.js"
    },
    "./inspector": {
      "types": "./dist/inspector/index.d.ts",
      "default": "./dist/inspector/index.js"
    },
    "./shared-navigation": {
      "types": "./dist/shared-navigation/index.d.ts",
      "default": "./dist/shared-navigation/index.js"
    },
    "./interactive-navigation": {
      "types": "./dist/interactive-navigation/index.d.ts",
      "default": "./dist/interactive-navigation/index.js"
    },
    "./predictive-back": {
      "types": "./dist/predictive-back/index.d.ts",
      "default": "./dist/predictive-back/index.js"
    },
    "./sensors": {
      "types": "./dist/sensors/index.d.ts",
      "default": "./dist/sensors/index.js"
    },
    "./physics": {
      "types": "./dist/physics/index.d.ts",
      "default": "./dist/physics/index.js"
    },
    "./shapes": {
      "types": "./dist/shapes/index.d.ts",
      "default": "./dist/shapes/index.js"
    },
    "./blur": {
      "types": "./dist/blur/index.d.ts",
      "default": "./dist/blur/index.js"
    },
    "./glass": {
      "types": "./dist/glass/index.d.ts",
      "default": "./dist/glass/index.js"
    },
    "./web": {
      "types": "./dist/web/public.d.ts",
      "default": "./dist/web/public.js"
    },
    "./web/vue": {
      "types": "./dist/web/vue/index.d.ts",
      "default": "./dist/web/vue/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "platforms/ios",
    "platforms/android/java",
    "platforms/android/include.gradle",
    "platforms/android/proguard-rules.pro"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && tsc -p tsconfig.web.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "benchmark:typecheck": "tsc -p benchmarks/tsconfig.json",
    "core:check": "tsc -p tsconfig.core.json && node scripts/check-portable-core.mjs",
    "web:proof": "node benchmarks/web-composition/server.mjs",
    "web:proof:typecheck": "tsc -p benchmarks/web-composition/tsconfig.json",
    "web:proof:test": "playwright test -c benchmarks/web-composition/playwright.config.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepack": "npm run build",
    "docs:check-media": "node scripts/check-docs-media.mjs",
    "web:typecheck": "tsc -p tsconfig.web.json --noEmit",
    "web:runtime": "node benchmarks/web-runtime/server.mjs",
    "web:runtime:typecheck": "tsc -p benchmarks/web-runtime/tsconfig.json",
    "web:runtime:test": "playwright test -c benchmarks/web-runtime/playwright.config.mjs",
    "web:check": "node scripts/check-web-runtime.mjs",
    "package:check": "node scripts/check-package-consumers.mjs",
    "web:press": "node benchmarks/web-press/server.mjs",
    "web:press:typecheck": "tsc -p benchmarks/web-press/tsconfig.json",
    "web:press:test": "playwright test -c benchmarks/web-press/playwright.config.mjs",
    "web:integration": "node benchmarks/web-integration/server.mjs",
    "web:integration:typecheck": "tsc -p benchmarks/web-integration/tsconfig.json",
    "web:integration:test": "playwright test -c benchmarks/web-integration/playwright.config.mjs",
    "web:dynamic": "node benchmarks/web-dynamic/server.mjs",
    "web:dynamic:typecheck": "tsc -p benchmarks/web-dynamic/tsconfig.json",
    "web:dynamic:test": "playwright test -c benchmarks/web-dynamic/playwright.config.mjs",
    "web:support": "node benchmarks/web-support/server.mjs",
    "web:support:typecheck": "tsc -p benchmarks/web-support/tsconfig.json",
    "web:support:test": "playwright test -c benchmarks/web-support/playwright.config.mjs",
    "web:visual": "node benchmarks/web-visual/server.mjs",
    "web:visual:typecheck": "tsc -p benchmarks/web-visual/tsconfig.json",
    "web:visual:test": "playwright test -c benchmarks/web-visual/playwright.config.mjs",
    "web:lifecycle": "node benchmarks/web-lifecycle/server.mjs",
    "web:lifecycle:typecheck": "tsc -p benchmarks/web-lifecycle/tsconfig.json",
    "web:lifecycle:test": "playwright test -c benchmarks/web-lifecycle/playwright.config.mjs",
    "web:orchestration": "node benchmarks/web-orchestration/server.mjs",
    "web:orchestration:typecheck": "tsc -p benchmarks/web-orchestration/tsconfig.json",
    "web:orchestration:test": "playwright test -c benchmarks/web-orchestration/playwright.config.mjs",
    "web:attachment": "node benchmarks/web-attachment/server.mjs",
    "web:attachment:typecheck": "tsc -p benchmarks/web-attachment/tsconfig.json",
    "web:attachment:test": "playwright test -c benchmarks/web-attachment/playwright.config.mjs",
    "package:nuxt:check": "node scripts/check-nuxt-consumer.mjs"
  },
  "peerDependencies": {
    "@nativescript/core": ">=8.9.0",
    "nativescript-vue": ">=3.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "nativescript-vue": {
      "optional": true
    },
    "@nativescript/core": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nativescript/core": "^9.1.3",
    "@nativescript/types-android": "^9.1.1",
    "@nativescript/types-ios": "^9.1.3",
    "@playwright/test": "1.64.1",
    "nativescript-vue": "3.1.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.4",
    "vue": "^3.5.44"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "nativescript": {
    "platforms": {
      "android": "8.9.0",
      "ios": "8.9.0"
    }
  }
}
