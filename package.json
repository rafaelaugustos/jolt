{
  "name": "@rafaelaugusto/jolt",
  "version": "0.1.0-beta.14",
  "description": "Native animations for NativeScript: presets, springs, keyframes and stagger in one call.",
  "keywords": [
    "nativescript",
    "animation",
    "animations",
    "motion",
    "spring",
    "keyframes",
    "ios",
    "android",
    "vue"
  ],
  "author": "Rafael Augusto",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafaelaugustos/jolt.git"
  },
  "homepage": "https://github.com/rafaelaugustos/jolt#readme",
  "bugs": "https://github.com/rafaelaugustos/jolt/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "default": "./dist/vue/index.js"
    },
    "./package.json": "./package.json",
    "./native": {
      "types": "./dist/native/index.d.ts",
      "default": "./dist/native/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "platforms/ios",
    "platforms/android/java",
    "platforms/android/include.gradle",
    "platforms/android/proguard-rules.pro"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "benchmark:typecheck": "tsc -p benchmarks/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepack": "npm run build",
    "docs:check-media": "node scripts/check-docs-media.mjs"
  },
  "peerDependencies": {
    "@nativescript/core": ">=8.9.0",
    "nativescript-vue": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "nativescript-vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nativescript/core": "^9.1.3",
    "@nativescript/types-android": "^9.1.1",
    "@nativescript/types-ios": "^9.1.3",
    "nativescript-vue": "3.1.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "nativescript": {
    "platforms": {
      "android": "8.9.0",
      "ios": "8.9.0"
    }
  }
}
