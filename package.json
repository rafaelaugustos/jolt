  "sideEffects": false,
  "scripts": {
    "parity:check": "node scripts/check-capability-matrix.mjs",
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && tsc -p tsconfig.web.json && npm run build:angular",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "benchmark:typecheck": "tsc -p benchmarks/tsconfig.json",
    "core:check": "tsc -p tsconfig.core.json && node scripts/check-portable-core.mjs",
    "web:proof": "node benchmarks/web-composition/server.mjs",
    "web:proof:typecheck": "tsc -p benchmarks/web-composition/tsconfig.json",
    "web:proof:test": "playwright test -c benchmarks/web-composition/playwright.config.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "node --max-old-space-size=1280 node_modules/vitepress/bin/vitepress.js build docs",
    "docs:preview": "vitepress preview docs",
    "prepack": "npm run build",
    "docs:check-media": "node scripts/check-docs-media.mjs && node scripts/check-motion-recipes.mjs && npm run docs:check-playground",
    "docs:test-site": "node scripts/review-motion-site.mjs",
    "media:upload": "node scripts/media.mjs upload",
    "media:pull": "node scripts/media.mjs pull",
    "media:verify": "node scripts/media.mjs verify",
    "web:typecheck": "tsc -p tsconfig.web.json --noEmit",
    "web:runtime": "node benchmarks/web-runtime/server.mjs",
    "web:runtime:typecheck": "tsc -p benchmarks/web-runtime/tsconfig.json",
    "web:runtime:test": "playwright test -c benchmarks/web-runtime/playwright.config.mjs",
    "web:check": "node scripts/check-web-runtime.mjs",
    "package:check": "node scripts/check-package-consumers.mjs",
    "web:press": "node benchmarks/web-press/server.mjs",
    "web:press:typecheck": "tsc -p benchmarks/web-press/tsconfig.json",
    "web:press:test": "playwright test -c benchmarks/web-press/playwright.config.mjs",
    "web:integration": "node benchmarks/web-integration/server.mjs",
    "web:integration:typecheck": "tsc -p benchmarks/web-integration/tsconfig.json",
    "web:integration:test": "playwright test -c benchmarks/web-integration/playwright.config.mjs",
    "web:dynamic": "node benchmarks/web-dynamic/server.mjs",
    "web:dynamic:typecheck": "tsc -p benchmarks/web-dynamic/tsconfig.json",
    "web:dynamic:test": "playwright test -c benchmarks/web-dynamic/playwright.config.mjs",
    "web:support": "node benchmarks/web-support/server.mjs",
    "web:support:typecheck": "tsc -p benchmarks/web-support/tsconfig.json",
    "web:support:test": "playwright test -c benchmarks/web-support/playwright.config.mjs",
    "web:visual": "node benchmarks/web-visual/server.mjs",
    "web:visual:typecheck": "tsc -p benchmarks/web-visual/tsconfig.json",
    "web:visual:test": "playwright test -c benchmarks/web-visual/playwright.config.mjs",
    "web:lifecycle": "node benchmarks/web-lifecycle/server.mjs",
    "web:lifecycle:typecheck": "tsc -p benchmarks/web-lifecycle/tsconfig.json",
    "web:lifecycle:test": "playwright test -c benchmarks/web-lifecycle/playwright.config.mjs",
    "web:orchestration": "node benchmarks/web-orchestration/server.mjs",
    "web:orchestration:typecheck": "tsc -p benchmarks/web-orchestration/tsconfig.json",
    "web:orchestration:test": "playwright test -c benchmarks/web-orchestration/playwright.config.mjs",
    "web:attachment": "node benchmarks/web-attachment/server.mjs",
    "web:attachment:typecheck": "tsc -p benchmarks/web-attachment/tsconfig.json",
    "web:attachment:test": "playwright test -c benchmarks/web-attachment/playwright.config.mjs",
    "package:nuxt:check": "node scripts/check-nuxt-consumer.mjs",
    "web:gestures": "node benchmarks/web-gestures/server.mjs",
    "web:gestures:typecheck": "tsc -p benchmarks/web-gestures/tsconfig.json",
    "web:gestures:test": "playwright test -c benchmarks/web-gestures/playwright.config.mjs",
    "web:effects": "node benchmarks/web-effects/server.mjs",
    "web:effects:typecheck": "tsc -p benchmarks/web-effects/tsconfig.json",
    "web:effects:test": "playwright test -c benchmarks/web-effects/playwright.config.mjs",
    "web:surfaces": "node benchmarks/web-surfaces/server.mjs",
    "web:surfaces:typecheck": "tsc -p benchmarks/web-surfaces/tsconfig.json",
    "web:surfaces:test": "playwright test -c benchmarks/web-surfaces/playwright.config.mjs",
    "web:platforms": "node benchmarks/web-platforms/server.mjs",
    "web:platforms:typecheck": "tsc -p benchmarks/web-platforms/tsconfig.json",
    "web:platforms:test": "playwright test -c benchmarks/web-platforms/playwright.config.mjs",
    "web:parity": "node benchmarks/web-parity/server.mjs",
    "web:parity:typecheck": "tsc -p benchmarks/web-parity/tsconfig.json",
    "web:parity:test": "playwright test -c benchmarks/web-parity/playwright.config.mjs",
    "build:angular": "node benchmarks/angular-tools/node_modules/@angular/compiler-cli/bundles/src/bin/ngc.js -p tsconfig.angular.json && node benchmarks/angular-tools/node_modules/@angular/compiler-cli/bundles/src/bin/ngc.js -p tsconfig.angular-web.json",
    "docs:check-playground": "tsc -p tsconfig.playground.json && node scripts/check-playground.mjs",
    "docs:test-playground": "node scripts/review-playground.mjs",
    "web:portable": "node benchmarks/web-portable/server.mjs",
    "web:portable:typecheck": "tsc -p benchmarks/web-portable/tsconfig.json",
    "web:portable:test": "playwright test -c benchmarks/web-portable/playwright.config.mjs",
    "web:interaction-depth": "node benchmarks/web-interaction-depth/server.mjs",
    "web:interaction-depth:typecheck": "tsc -p benchmarks/web-interaction-depth/tsconfig.json",
    "web:interaction-depth:test": "playwright test -c benchmarks/web-interaction-depth/playwright.config.mjs",
    "web:composition-portable": "node benchmarks/web-composition-portable/server.mjs",
    "web:composition-portable:typecheck": "tsc -p benchmarks/web-composition-portable/tsconfig.json",
    "web:composition-portable:test": "playwright test -c benchmarks/web-composition-portable/playwright.config.mjs",
    "web:frameworks": "node benchmarks/web-frameworks/server.mjs",
    "web:frameworks:test": "playwright test -c benchmarks/web-frameworks/playwright.config.mjs",
    "swiftui:generate": "node scripts/generate-swiftui-definitions.mjs",
    "swiftui:check": "node scripts/generate-swiftui-definitions.mjs --check",
    "swiftui:test": "swift test",
    "swift:package": "node scripts/swift-package.mjs"
  },
